    "Not an InDesign file" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InDesignファイルではありません"
          }
        }
      }
    },
    "Only some file types were associated with %@." : {
      "comment" : "Preferences: status when the user kept the current app for some file types",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部の種類だけ%@に関連付けました。"
          }
        }
      }
    },
    "Open" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開く"
          }
        }
      }
    },
    "Open with %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@で開く"
          }
        }
      }
    },
    "Open…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開く…"
          }
        }
      }
    },
    "Preferences…" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定…"
          }
        }
      }
    },
    "Quit" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "終了"
          }
        }
      }
    },
    "Quit Glow Id, move it to the Applications folder in the Finder, and then open it again." : {
      "comment" : "Translocation alert, 3rd paragraph",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idを終了し、Finderでアプリケーションフォルダへ移動してから、もう一度開いてください。"
          }
        }
      }
    },
    "Quit Glow Id, move it to the Applications folder in the Finder, and then open it again. If it's already in the Applications folder, move it to the Desktop and back again in the Finder." : {
      "comment" : "Translocation alert, 3rd paragraph (original location unknown)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idを終了し、Finderでアプリケーションフォルダへ移動してから、もう一度開いてください。すでにアプリケーションフォルダにある場合は、Finderでいったんデスクトップへ移動してから戻してください。"
          }
        }
      }
    },
    "Status" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "状態"
          }
        }
      }
    },
    "System Requirement" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム要件"
          }
        }
      }
    },
    "The file association was kept as it is." : {
      "comment" : "Preferences: status when the user chose to keep the current app in the macOS confirmation",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関連付けは変更していません。"
          }
        }
      }
    },
    "The file association was not changed." : {
      "comment" : "Alert: title when the file association was not applied",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの関連付けが変更されませんでした。"
          }
        }
      }
    },
    "The icons couldn't be imported." : {
      "comment" : "Preferences: status when importing the icons failed",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイコンを取り込めませんでした。"
          }
        }
      }
    },
    "The icons in Glow Id are up to date." : {
      "comment" : "Preferences: status when the icons in Glow Id are the same as InDesign's",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idの中にあるアイコンは最新です。"
          }
        }
      }
    },
    "To import icons, log in with an administrator account." : {
      "comment" : "Preferences: why the icons can't be imported (not writable)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り込むには、管理者のアカウントでログインしてください。"
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン"
          }
        }
      }
    },
    "Version detection (.indd)" : {
      "comment" : "Preferences window: section header for the version detection mode of InDesign documents",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出バージョン（.indd）"
          }
        }
      }
    },
    "Version info cannot be detected" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version info \ncannot be detected"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バージョン情報を\n検出できませんでした"
          }
        }
      }
    },
    "Waiting for confirmation…" : {
      "comment" : "Preferences: status while waiting for the macOS confirmation",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認を待っています…"
          }
        }
      }
    },
    "When Opening Files" : {
      "comment" : "Preferences window: section header for the option about opening files",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルを開くとき"
          }
        }
      }
    }
  },
  "version" : "1.0"
