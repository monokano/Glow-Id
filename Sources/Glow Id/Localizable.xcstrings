{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ (current)" : {
      "comment" : "Preferences: radio button title of the app currently associated",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（現在）"
          }
        }
      }
    },
    "Adobe InDesign (not installed)" : {
      "comment" : "Preferences: radio button title when no release version of InDesign is installed",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adobe InDesign（見つかりません）"
          }
        }
      }
    },
    "Allow opening in higher version" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上位バージョンで開くのを許可する"
          }
        }
      }
    },
    "Already associated with %@." : {
      "comment" : "Preferences: status when the files are already associated with the chosen app",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに%@に関連付けられています。"
          }
        }
      }
    },
    "Always show notification window (do not open automatically)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に通知ウインドウを表示する"
          }
        }
      }
    },
    "Another InDesign.app is already running" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another InDesign.app \nis already running"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別バージョンのInDesignが\n起動しています"
          }
        }
      }
    },
    "Application" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリケーション"
          }
        }
      }
    },
    "Associate" : {
      "comment" : "Preferences: button to change the file association",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関連付ける"
          }
        }
      }
    },
    "Associated with %@." : {
      "comment" : "Preferences: status after the file association was changed",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に関連付けました。"
          }
        }
      }
    },
    "Back" : {
      "comment" : "Help window toolbar: go back (accessibility name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻る"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        }
      }
    },
    "Choose the app that opens when you double-click a file." : {
      "comment" : "Preferences: note under the file association heading",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルクリックしたときに開くアプリを選びます。"
          }
        }
      }
    },
    "Continue Anyway" : {
      "comment" : "Translocation alert button",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このまま続ける"
          }
        }
      }
    },
    "Copies the .indd, .indt, .indb, .indl, and .idml icons from %@ into Glow Id, so files associated with Glow Id also show the latest InDesign icons." : {
      "comment" : "Preferences: note under the file icons heading (%@ = InDesign name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の.indd／.indt／.indb／.indl／.idmlのアイコンをGlow Idに取り込みます。Glow Idに関連付けたファイルのアイコンをInDesignの最新アイコンにするためです。"
          }
        }
      }
    },
    "Do not show build number" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビルド番号を表示しない"
          }
        }
      }
    },
    "Extension does not match" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張子が一致していません"
          }
        }
      }
    },
    "File association (.indd / .indt / .indb / .indl / .idml)" : {
      "comment" : "Preferences: section heading",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの関連付け（.indd／.indt／.indb／.indl／.idml）"
          }
        }
      }
    },
    "File icons" : {
      "comment" : "Preferences: section heading",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルアイコン"
          }
        }
      }
    },
    "For security, macOS runs apps obtained from the internet from a copy in a temporary location until you move them in the Finder." : {
      "comment" : "Translocation alert, 2nd paragraph",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSは安全のため、インターネットから入手したアプリをFinderで移動するまでは、元の場所ではなく一時的な場所に置いたコピーから起動します。"
          }
        }
      }
    },
    "Forward" : {
      "comment" : "Help window toolbar: go forward (accessibility name)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進む"
          }
        }
      }
    },
    "Full Version (Document History)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルバージョン（ドキュメントヒストリー）"
          }
        }
      }
    },
    "Glow Id - Notification" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Id - 通知"
          }
        }
      }
    },
    "Glow Id can't be changed because it's owned by the system." : {
      "comment" : "Preferences: why the icons can't be imported (root owned)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idがシステムの所有になっているため、取り込めません。"
          }
        }
      }
    },
    "Glow Id Help" : {
      "comment" : "Help window title",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idヘルプ"
          }
        }
      }
    },
    "Glow Id is in the Applications folder, but it was placed there without being moved in the Finder, for example by unzipping it there. Quit Glow Id, move it to the Desktop in the Finder, move it back to the Applications folder, and then open it again." : {
      "comment" : "Translocation alert, 3rd paragraph (original location is inside the Applications folder)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idはアプリケーションフォルダにありますが、そこでZIPを展開した場合など、Finderで移動せずに置かれています。Glow Idを終了し、Finderでいったんデスクトップへ移動してからアプリケーションフォルダへ戻し、もう一度開いてください。"
          }
        }
      }
    },
    "Glow Id is running from a temporary location because it was opened right after being downloaded." : {
      "comment" : "Translocation alert, 1st paragraph",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした直後のため、Glow Idは一時的な場所から起動しています。"
          }
        }
      }
    },
    "Glow Id Preferences" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Id設定"
          }
        }
      }
    },
    "Help" : {
      "comment" : "Dock menu: opens the help window",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルプ"
          }
        }
      }
    },
    "Import Icons" : {
      "comment" : "Preferences: button to import the document icons from InDesign",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アイコンを取り込む"
          }
        }
      }
    },
    "Imported the icons from %@." : {
      "comment" : "Preferences: status after importing the icons",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のアイコンを取り込みました。"
          }
        }
      }
    },
    "InDesign Book (.indb)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InDesignブック（.indb）"
          }
        }
      }
    },
    "InDesign Document (.indd)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InDesignドキュメント（.indd）"
          }
        }
      }
    },
    "InDesign Library (.indl)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InDesignライブラリ（.indl）"
          }
        }
      }
    },
    "InDesign Markup (.idml)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InDesign Markup (.idml)"
          }
        }
      }
    },
    "InDesign Template (.indt)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InDesignテンプレート（.indt）"
          }
        }
      }
    },
    "macOS security may prevent this change. In the Finder, select a .indd, .indt, .indb, .indl, or .idml file, choose Get Info, choose the app in \"Open with\", and click \"Change All…\"." : {
      "comment" : "Alert: informative text when the file association was not applied",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSのセキュリティにより変更されないことがあります。Finderで.indd／.indt／.indb／.indl／.idmlファイルを選んで「情報を見る」を開き、「このアプリケーションで開く」でアプリを選んで「すべてを変更」をクリックしてください。"
          }
        }
      }
    },
    "Major + Minor (Header)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メジャー＋マイナー（ヘッダー）"
          }
        }
      }
    },
    "Move Glow Id again in the Finder" : {
      "comment" : "Translocation alert title (original location is inside the Applications folder)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow IdをFinderで移動し直してください"
          }
        }
      }
    },
    "Move Glow Id to the Applications folder" : {
      "comment" : "Translocation alert title",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idをアプリケーションフォルダへ移動してください"
          }
        }
      }
    },
    "Move Glow Id to the Applications folder, then open it again." : {
      "comment" : "Preferences: why the icons can't be imported (App Translocation)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glow Idをアプリケーションフォルダに移動して、開き直してください。"
          }
        }
      }
    },
    "No Adobe InDesign icons were found." : {
      "comment" : "Preferences: why the icons can't be imported",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adobe InDesignのアイコンが見つかりません。"
          }
        }
      }
    },
    "No InDesign.app with matching major version" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No InDesign.app \nwith matching major version"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "同じメジャーバージョンの\nInDesignがありません"
          }
        }
